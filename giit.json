{
  "sphinx": [
    {
      "scripts": [
        "pip install . && cd docs && sphinx-build -b html -W -D version=${release} . ${build_path}/${release}"
      ],
      "requirements": "${source_path}/docs/requirements.txt",
      "workingtree": true,
      "variables": {
        "tag:release": "${name}",
        "workingtree:release": "latest"
      }
    },
    {
      "scripts": [
        "versjon --docs_path ${build_path}"
      ]
    }
  ]
}
